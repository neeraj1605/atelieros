{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planex.ai/schemas/metric-spatial-contract-1.0.json",
  "title": "Metric Spatial Contract",
  "description": "Normalized, millimetre-accurate spatial description of a built interior. Single source of truth across the measurement, design, estimation and execution tiers.",
  "type": "object",
  "required": ["contract_version", "coordinate_system", "units", "source", "provenance", "rooms"],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "const": "1.0" },
    "coordinate_system": { "const": "EPSG:Metric_Cartesian_MM" },
    "units": {
      "type": "object",
      "required": ["length", "angle"],
      "additionalProperties": false,
      "properties": {
        "length": { "const": "mm" },
        "angle": { "const": "deg" }
      }
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["photos", "video", "blueprint_pdf", "blueprint_dwg", "blueprint_image", "manual"]
        },
        "uri": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "device": { "type": "string" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "origin": { "type": "string", "description": "Human-readable description of the local origin." },
        "gravity": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "number" }
        },
        "transform": {
          "type": "array", "minItems": 16, "maxItems": 16,
          "items": { "type": "number" },
          "description": "Column-major 4x4 transform from model space to EPSG:Metric_Cartesian_MM."
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/room" }
    },
    "walls": {
      "type": "array",
      "items": { "$ref": "#/$defs/wall" },
      "description": "Optional explicit wall topology (Module 2+). Derived from room polygons when absent."
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "point_mm": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "integer" }
    },
    "polygon_mm": {
      "type": "array",
      "minItems": 3,
      "description": "Planar ring of [x, y] millimetres. Implicitly closed; an explicit repeat of the first point is tolerated and normalized away.",
      "items": { "$ref": "#/$defs/point_mm" }
    },
    "opening": {
      "type": "object",
      "required": ["type", "start_mm", "width_mm", "height_mm"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["door", "window", "opening", "arch", "balcony_slider"] },
        "start_mm": { "$ref": "#/$defs/point_mm", "description": "Point on the room boundary where the opening begins, following the polygon winding." },
        "width_mm": { "type": "integer", "minimum": 1 },
        "height_mm": { "type": "integer", "minimum": 1 },
        "sill_mm": { "type": "integer", "minimum": 0, "description": "Height of the sill above floor level. Doors are 0." },
        "sill_height_mm": { "type": "integer", "minimum": 0, "description": "Alias for sill_mm (Pydantic schema compatibility)." },
        "wall_index": { "type": "integer", "minimum": 0, "description": "Index into the perimeter polygon edges." },
        "offset_mm": { "type": "number", "description": "Offset along the wall (positive = along wall direction)." },
        "swing_deg": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "room": {
      "type": "object",
      "required": ["id", "boundary_polygon", "ceiling_height_mm"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_\\-]*$" },
        "name": { "type": "string" },
        "level": { "type": "integer", "default": 0 },
        "kind": { "type": "string", "description": "Planex room kind: living, dining, kitchen, bedroom, bath, ..." },
        "boundary_polygon": { "$ref": "#/$defs/polygon_mm" },
        "ceiling_height_mm": { "type": "integer", "minimum": 1 },
        "floor_elevation_mm": { "type": "integer" },
        "openings": { "type": "array", "items": { "$ref": "#/$defs/opening" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "wall_thickness_ext_mm": { "type": "integer", "minimum": 1, "description": "External wall thickness (Indian standard: 230mm)" },
        "wall_thickness_int_mm": { "type": "integer", "minimum": 1, "description": "Internal partition wall thickness (Indian standard: 115mm)" }
      }
    },
    "wall": {
      "type": "object",
      "required": ["id", "start_mm", "end_mm", "thickness_mm"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "start_mm": { "$ref": "#/$defs/point_mm" },
        "end_mm": { "$ref": "#/$defs/point_mm" },
        "thickness_mm": { "type": "integer", "minimum": 1 },
        "height_mm": { "type": "integer", "minimum": 1 },
        "room_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["measured_by"],
      "additionalProperties": false,
      "properties": {
        "measured_by": {
          "enum": [
            "metric3d_v2", "droid_slam", "metric3d_v2+droid_slam",
            "polyworld", "layoutformer_pp", "manual", "hybrid"
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "version"],
            "additionalProperties": true,
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "weights_sha256": { "type": "string" }
            }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      }
    }
  }
}
